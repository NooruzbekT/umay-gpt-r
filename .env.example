# ---------- LLM ----------
# Провайдер: auto (по найденному ключу) | qwen | openai | anthropic | rule (без LLM)
LLM_PROVIDER=auto
# Qwen (Alibaba Cloud Model Studio / DashScope, OpenAI-совместимый режим)
QWEN_API_KEY=
# Международный регион по умолчанию; для материкового Китая: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
UMAY_LLM_MODEL=qwen-plus
# Альтернативы: OPENAI_API_KEY=... или ANTHROPIC_API_KEY=...

# ---------- Каталог ----------
# demo — синтетика (тесты) | snapshot — срез реального каталога Umay (офлайн) | live — публичный API Umay
UMAY_CATALOG=live

# ---------- Прочее ----------
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=30
# 1 — включить /inspector (dev), 0 — выключить в проде
UMAY_DEV=1
